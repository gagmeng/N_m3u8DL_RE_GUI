<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every text/background pair keeps WCAG AA (4.5:1 normal text,
         3:1 UI boundaries), verified by XamlContrastTests against this file. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F4F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushCustom" Color="#8A8AA0"/>
    <!-- The accent ramp shifts one step darker so white label text keeps >=6:1;
         hover/pressed still darken, preserving the "contrast rises on interaction" rule. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4350D8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3B47C4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3743BE"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#303BB0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A24"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55556E"/>
    <!-- #F39C12 measured 2.19:1 on white — deepened to an AA-passing amber. -->
    <SolidColorBrush x:Key="CfAmberBrush" Color="#8A5A00"/>
    <SolidColorBrush x:Key="CommandBarBrush" Color="#E9EAF0"/>
    <SolidColorBrush x:Key="CommandTextBrush" Color="#2A3A8C"/>
    <SolidColorBrush x:Key="DropLabelBrush" Color="#B03A2E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#147A3D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="CfWarningBgBrush" Color="#FDF3D7"/>
    <SolidColorBrush x:Key="DimBrush" Color="#66667C"/>
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#EDEDF2"/>
</ResourceDictionary>
